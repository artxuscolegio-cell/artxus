VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_PHOTOS_COLLECTION_ID=photos
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=notifications
VITE_APPWRITE_BUCKET_ID=your_bucket_id

# Push notifications (ntfy.sh)
VITE_NTFY_TOPIC=artxus-admin-notifs
# URL base de tu app en Vercel (sin slash al final)
VITE_MODERATE_ENDPOINT=https://your-app.vercel.app
# Token secreto — elegí uno largo y random, copialo también en Vercel como MODERATE_TOKEN
VITE_MODERATE_TOKEN=your_secret_token_here

# Variables SERVER-SIDE para la Vercel Function /api/moderate
# (estas NO llevan prefijo VITE_ — no se exponen al browser)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_PHOTOS_COLLECTION_ID=photos
APPWRITE_API_KEY=your_appwrite_server_api_key
MODERATE_TOKEN=your_secret_token_here